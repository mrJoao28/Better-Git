{
  "name": "repository-intelligence-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deep GitHub repository discovery and evidence-based analysis through MCP.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector npm run dev",
    "validate:registry": "mcp-publisher validate",
    "publish:registry": "mcp-publisher publish"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@octokit/rest": "^22.0.0",
    "dotenv": "^17.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "mcpName": "io.github.mrJoao28/repository-intelligence-mcp",
  "bin": {
    "repository-intelligence-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ]
}
